  137 0000000A         HardFault_Handler
                               PROC
  138 0000000A                 EXPORT           HardFault_Handler          [WEA
K]
  139 0000000A         ; 1. 写崩溃信息到 SRAM 保留区 (0x2000BBE0)
  140 0000000A 4811            LDR              R0, =0x2000BBE0
  141 0000000C 4911            LDR              R1, =0xDEADBEEF
  142 0000000E 6001            STR              R1, [R0, #0] ; CRASH_ADDR[0] = 
                                                            magic
  143 00000010 2104            MOVS             R1, #4
  144 00000012 6041            STR              R1, [R0, #4] ; CRASH_ADDR[1] = 
                                                            reason=4
  145 00000014 F3EF 8208       MRS              R2, MSP
  146 00000018 6993            LDR              R3, [R2, #24]
  147 0000001A 6083            STR              R3, [R0, #8] ; CRASH_ADDR[2] = 
                                                            faulting PC
  148 0000001C         ; 2. 使能 GPIOB 时钟 (RCC->APB2PCLKEN |= BIT(3))
  149 0000001C 480E            LDR              R0, =0x40021018 
                                                            ; RCC->APB2PCLKEN
  150 0000001E 6801            LDR              R1, [R0]
  151 00000020 2208            MOVS             R2, #8      ; RCC_APB2_PERIPH_G
                                                            PIOB
  152 00000022 4311            ORRS             R1, R1, R2
  153 00000024 6001            STR              R1, [R0]
  154 00000026         ; 3. 亮 LED1 (GPIOB->PBSC = BIT(3))
  155 00000026 480D            LDR              R0, =0x40010C18 ; GPIOB->PBSC
  156 00000028 2108            MOVS             R1, #8      ; GPIO_PIN_3
  157 0000002A 6001            STR              R1, [R0]
  158 0000002C         ; 4. 延时 ~100ms
  159 0000002C 4B0C            LDR              R3, =2500000
  160 0000002E 1E5B    delay_loop
                               SUBS             R3, R3, #1
  161 00000030 D1FD            BNE              delay_loop
  162 00000032         ; 5. 系统复位
  163 00000032 480C            LDR              R0, =0xE000ED0C ; SCB->AIRCR
  164 00000034 490C            LDR              R1, =0x05FA0004 ; VECTKEY | SYS
                                                            RESETREQ
  165 00000036 6001            STR              R1, [R0]
  166 00000038 F3BF 8F4F       DSB
  167 0000003C E7FE            B                .
  168 0000003E                 ENDP



